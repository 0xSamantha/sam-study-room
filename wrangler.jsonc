{
  "name": "the-reading-room",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/room/*"]},
  "durable_objects": {"bindings": [{"name": "ROOM", "class_name": "StudyRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["StudyRoom"]}]
}
